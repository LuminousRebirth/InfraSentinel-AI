INFRASENTINEL_ENV=development
INFRASENTINEL_SECRET_KEY=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql+psycopg://infrasentinel:replace-password@127.0.0.1:5432/infrasentinel
POSTGRES_USER=infrasentinel
POSTGRES_PASSWORD=replace-password
POSTGRES_DB=infrasentinel
REDIS_PASSWORD=replace-password
REDIS_URL=redis://:replace-password@127.0.0.1:6379/0
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MINIO_ROOT_USER=infrasentinel
MINIO_ROOT_PASSWORD=replace-with-at-least-16-characters
STORAGE_ROOT=runtime/storage
STORAGE_WARNING_GB=900
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_DAYS=7
SESSION_TOUCH_MINUTES=5
ALLOWED_ORIGINS=http://127.0.0.1:8090,http://localhost:8090,http://127.0.0.1:5173,http://localhost:5173
INFRASENTINEL_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
INFRASENTINEL_BOOTSTRAP_ADMIN_USERNAME=admin
INFRASENTINEL_BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-12-characters
INFRASENTINEL_BOOTSTRAP_ADMIN_DISPLAY_NAME=InfraSentinel Admin
INFRASENTINEL_BOOTSTRAP_ADMIN_LOCALE=zh-CN
